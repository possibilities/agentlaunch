{
  "$schema": "./catalog.schema.json",
  "families": {
    "claude": {
      "efforts": ["low", "medium", "high", "xhigh", "max"],
      "models": [
        { "model": "fable" },
        { "model": "opus-1m", "spelling": "opus[1m]" },
        { "model": "opus" },
        { "model": "sonnet-1m", "spelling": "sonnet[1m]" },
        { "model": "sonnet" },
        { "model": "haiku" }
