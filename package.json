{
  "name": "agentlaunch",
  "version": "0.1.0",
  "description": "Resolve, balance, launch, and resume native Claude Code, Codex, and Pi sessions",
  "private": false,
  "keywords": [
    "ai",
    "agent",
    "claude",
    "codex",
    "pi",
    "launcher"
  ],
  "homepage": "https://github.com/possibilities/agentlaunch#readme",
  "bugs": "https://github.com/possibilities/agentlaunch/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/possibilities/agentlaunch.git"
  },
  "type": "module",
  "bin": {
    "agentlaunch": "./src/main.ts"
  },
  "files": [
    "src",
    "catalog.json",
    "catalog.schema.json",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write src test scripts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 20000",
    "generate:schemas": "bun run scripts/generate-schema.ts && biome check --write catalog.schema.json config.schema.json",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/bun": "1.3.14",
    "bun-types": "1.3.14",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "zod": "^4"
  }
}
